# CacheSplit — Environment Variables

# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── Security ──────────────────────────────────────────────────────────────────

# Secret key used to sign all Merkle commits and audit events.
# In production: load from AWS Secrets Manager / GCP Secret Manager / Vault.
# For local dev, leave as-is. Never deploy the default to production.
CACHESPLIT_SIGNING_KEY=your-secret-signing-key-change-this

# Pre-seed a developer API key for demos/testing.
# If empty, no key is pre-loaded — use POST /api/dev/keys to generate one.
CACHESPLIT_DEV_API_KEY=cs_live_your-key-here

# Lease signing key for repair operations.
# Must be different from CACHESPLIT_SIGNING_KEY.
CACHESPLIT_LEASE_KEY=your-lease-signing-key-change-this

# Audit log signing key for HMAC-signed event trail.
CACHESPLIT_AUDIT_KEY=your-audit-signing-key-change-this

# ── Auth ──────────────────────────────────────────────────────────────────────

# JWT token TTL in seconds (max 300 for security).
CACHESPLIT_JWT_TTL=300

# Token refresh TTL in seconds.
CACHESPLIT_REFRESH_TTL=86400

# ── Scale ─────────────────────────────────────────────────────────────────────

# Per-tenant queue max size (default: standard=1000, enterprise=5000, basic=500).
CACHESPLIT_QUEUE_MAX_PER_TENANT=1000

# Enterprise queue max size.
CACHESPLIT_QUEUE_MAX_ENTERPRISE=5000

# Basic queue max size.
CACHESPLIT_QUEUE_MAX_BASIC=500

# Ingress backpressure thresholds.
CACHESPLIT_INGRESS_THRESHOLD_ENTERPRISE=5000
CACHESPLIT_INGRESS_THRESHOLD_STANDARD=1000
CACHESPLIT_INGRESS_THRESHOLD_BASIC=500

# ── Infra ─────────────────────────────────────────────────────────────────────

# Topology cache TTL in seconds (default: 30).
CACHESPLIT_TOPOLOGY_TTL=30

# DR failover quorum threshold (default: 0.51 = majority).
CACHESPLIT_DR_QUORUM_THRESHOLD=0.51

# DR failover max backoff in seconds (default: 60).
CACHESPLIT_DR_MAX_BACKOFF=60

# ── Storage ────────────────────────────────────────────────────────────────────

# Storage adapter type: postgres, mongo, memory.
CACHESPLIT_STORAGE_ADAPTER=postgres

# Credential reference (Vault path or KMS ARN).
# Never pass plaintext credentials here.
CACHESPLIT_STORAGE_CREDENTIAL_REF=vault://cachesplit/prod/credentials

# ── Network ───────────────────────────────────────────────────────────────────

# Default network tier for new tenants.
CACHESPLIT_DEFAULT_NETWORK_TIER=standard

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for CORS.
# Use * only for fully public APIs with no credentials.
CACHESPLIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# ── Server ────────────────────────────────────────────────────────────────────

CACHESPLIT_HOST=127.0.0.1
CACHESPLIT_PORT=8000

# ── ML / AI ───────────────────────────────────────────────────────────────────

# Priority model fallback rate threshold (0.0-1.0).
# If exceeded, alerts are generated.
CACHESPLIT_PRIORITY_FALLBACK_THRESHOLD=0.3

# Anomaly detection score threshold.
CACHESPLIT_ANOMALY_SCORE_THRESHOLD=0.85

# Anomaly detection rolling window size.
CACHESPLIT_ANOMALY_ROLLING_WINDOW=100

# ── DR Failover ───────────────────────────────────────────────────────────────

# Auto-failback disabled by default for safety.
CACHESPLIT_DR_AUTO_FAILBACK=false

# Minimum time between failovers in seconds.
CACHESPLIT_DR_MIN_INTERVAL=300
